# Copy this file to .env and fill in real values.
# .env itself is git-ignored — never commit real secrets.

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://admin:secret@localhost:5432/ev_apm

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Your ML Model API ────────────────────────────────
# URL where your trained ML model is hosted and serving predictions
ML_API_URL=http://localhost:8001
ML_API_KEY=
ML_TIMEOUT_SECONDS=10

# ── Frontend ─────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Alert thresholds (optional — these have sensible defaults) ──
SOH_CRITICAL_THRESHOLD=0.60
SOH_WARNING_THRESHOLD=0.75
TEMP_CRITICAL_CELSIUS=55.0
TEMP_WARNING_CELSIUS=45.0
RUL_CRITICAL_DAYS=30
RUL_WARNING_DAYS=90
